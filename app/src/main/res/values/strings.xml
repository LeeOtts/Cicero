    <string name="perm_granted">%1$s granted</string>
    <string name="perm_bluetooth_title">Bluetooth</string>
    <string name="perm_bluetooth_body">The glasses connect over Bluetooth. Cicero needs permission to find and pair with them.</string>
    <string name="perm_bluetooth_action">Allow Bluetooth</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">Reminders you ask Cicero to set arrive as notifications. Without this they are scheduled but never shown.</string>
    <string name="perm_notifications_action">Allow notifications</string>
    <string name="perm_listener_title">Notification access</string>
    <string name="perm_listener_body">Needed to see and control what is playing in other apps. This one is a toggle in Android settings, not a prompt.</string>
    <string name="perm_listener_action">Open settings</string>
    <string name="perm_assistant_title">Digital assistant</string>
    <string name="perm_assistant_body">Makes long-pressing the power button open Cicero, so you can ask without unlocking and tapping. “Hey Meta” belongs to Meta AI and cannot be reassigned.</string>
    <string name="perm_assistant_action">Make Cicero the assistant</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_body">The glasses have no GPS of their own, so Cicero uses the phone\'s. Needed to answer where you are and to find things near you.</string>
    <string name="perm_location_action">Allow location</string>

