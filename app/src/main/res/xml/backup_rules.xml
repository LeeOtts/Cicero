<?xml version="1.0" encoding="utf-8"?><!--
   Ignored on API 31+, which is this app's minSdk, so nothing here is currently
   read. Kept in step with data_extraction_rules.xml so the two cannot drift if
   minSdk is ever lowered: API keys in files/datastore/ must not be backed up.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
