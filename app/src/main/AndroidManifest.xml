<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Identifies the current network, so the self-hosted server's LAN and
      Tailscale addresses can be re-decided the moment the phone changes network.
      A normal permission: granted at install, with nothing to ask the user.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Glasses microphone over Bluetooth HFP (Phase 2 onwards). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The glasses expose no GPS, so position comes from the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Reminders fire a notification when due. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Without this, SpeechRecognizer.isRecognitionAvailable() and
      createSpeechRecognizer() silently fail to find Google's on-device
      recognizer on API 30+ package-visibility rules, even though it exists.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".CiceroApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cicero.Starting">

        <!-- 0/0 is correct while Developer Mode is on; attestation is skipped. -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Makes Cicero eligible as the phone's digital assistant, which is
              what the long-press-power gesture launches. It lands on the Ask
              screen, so there is nothing extra to handle.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Meta AI returns here after registration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cicero" />
            </intent-filter>
        </activity>

        <!--
          Catches the OpenRouter sign-in redirect and hands the code back to the
          app. A separate activity, and a separate scheme, on purpose:

          - The "cicero" filter above is scheme-only, so it matches EVERY
            cicero:// URI. Putting the OAuth callback on that scheme would make
            two components match and raise an app chooser mid-sign-in.
          - MainActivity is launchMode="standard" and never reads its intent, so
            routing through it would flash the whole UI in the middle of a flow.

          The scheme is reverse-DNS per RFC 8252 section 7.1.
        -->
        <activity
            android:name=".OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.leeotts.cicero" android:host="oauth" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".tools.ReminderReceiver"
            android:exported="false" />

        <!--
          Notification Access does double duty. It is the only way to enumerate
          other apps' media sessions, which is how playback control reaches
          Spotify and Audible; and it is how incoming messages are captured for
          read_messages, which covers SMS, WhatsApp and Messenger alike without
          holding READ_SMS.
        -->
        <service
            android:name=".tools.CiceroNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
